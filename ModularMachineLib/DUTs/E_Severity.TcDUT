<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="E_Severity" Id="{055D7F93-88B2-456D-9152-953BD5A84D60}">
    <Declaration><![CDATA[
{attribute 'qualified_only'}
{attribute 'strict'}
// Error/message severity levels for FB_ErrorHandler
TYPE E_Severity :
(
    Info    := 0,   // Informational message only
    Warning := 1,   // Warning — machine continues
    Error   := 2,   // Error — machine stops, reset required
    Fatal   := 3    // Fatal — immediate shutdown
) UDINT;
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>