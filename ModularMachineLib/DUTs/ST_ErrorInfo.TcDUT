<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_ErrorInfo" Id="{9D98F54C-A476-4CBC-9076-428C06F31C5B}">
    <Declaration><![CDATA[
// Single error record used by FB_ErrorHandler
TYPE ST_ErrorInfo :
STRUCT
    nCode       : UDINT;            // Error code (see GVL_ErrorCodes)
    eSeverity   : E_Severity;       // Error severity level
    sMessage    : STRING(255);      // Human-readable error description
    sSource     : STRING(80);       // Function block / module name
    tTimestamp  : DT;               // Time of error occurrence
    bActive     : BOOL;             // Error is currently active
    bAcknowledged : BOOL;           // Operator has acknowledged
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>